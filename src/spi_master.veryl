}

/// Mode 3のCS setupと先頭Low幅が半周期であることを検証
#[test(test_spi_mode3_cs_setup)]
module test_spi_mode3_cs_setup {
    import Types::SpiMode;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var start   : logic   ;
    var tx_data : logic<8>;
    var rx_data : logic<8>;
    var busy    : logic   ;
    var done    : logic   ;
    var sclk_out: logic   ;
    var mosi    : logic   ;
    var miso    : logic   ;
    var cs_n    : logic   ;

    var cs_fall_at  : u32  ;
    var sclk_fall_at: u32  ;
    var sclk_rise_at: u32  ;
    var cs_seen     : logic;
    var fall_seen   : logic;
    var rise_seen   : logic;

    inst dut: SpiMaster::<SpiMode::Mode3> #(
        DATA_WIDTH: 8 ,
        CLK_DIV   : 20,
    ) (
        clk              ,
        rst              ,
        start            ,
        tx_data          ,
        rx_data          ,
        busy             ,
        done             ,
        sclk   : sclk_out,
        mosi             ,
        miso             ,
        cs_n             ,
    );

    initial {
        start   = 0;
        tx_data = 8'h00;
        miso    = 1;
        rst.assert();
        clk.next(10);

        start = 1;
        clk.next(1);
        start = 0;

        cs_fall_at   = 0;
        sclk_fall_at = 0;
        sclk_rise_at = 0;
        cs_seen      = 0;
        fall_seen    = 0;
        rise_seen    = 0;
        for i in 0..64 {
            if !cs_seen && cs_n == 0 {
                cs_seen    = 1;
                cs_fall_at = i;
            }
            if cs_seen && !fall_seen && sclk_out == 0 {
                fall_seen    = 1;
                sclk_fall_at = i;
            }
            if fall_seen && !rise_seen && sclk_out == 1 {
                rise_seen    = 1;
                sclk_rise_at = i;
            }
            clk.next(1);
        }

        $assert(cs_seen && fall_seen && rise_seen, "Mode 3 CS setup observation failed");
        $assert(sclk_fall_at - cs_fall_at == 10, "Mode 3 CS setup must be a half period");
        $assert(sclk_rise_at - sclk_fall_at == 10, "Mode 3 first SCLK Low width must be a half period");
        $finish();
    }
}

