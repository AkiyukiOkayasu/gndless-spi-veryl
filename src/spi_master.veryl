/// SPI共通型をimport
import Types::SpiMode;
import Types::SpiSampleEdge;
/// SPI Master モジュール
///
/// `start`はidle中に1クロックだけHighにし、同じcycleの`tx_data`を保持する。
/// 受理後は`busy`と`cs_n`をアサートし、全bitの転送とCS High保持時間が終わると`done`を1クロックだけHighにする。
/// 転送はMSB-first。
///
/// ```wavedrom
/// {
///   signal: [
///     { name: 'start',   wave: '010.............' },
///     { name: 'tx_data', wave: 'x3..............', data: ['word N'] },
///     { name: 'busy',    wave: '01..........0...' },
///     { name: 'cs_n',    wave: '1.0........1....' },
///     { name: 'sclk',    wave: '0..p.....|p..0..' },
///     { name: 'done',    wave: '0...........10..' }
///   ],
///   head: { text: 'SPI transaction (transfer interval abbreviated)' }
/// }
/// ```
///
/// CPOLはidle level、CPHAは最初のedgeがshiftかsampleかを決める。
/// Mode 0/2はleading edgeでsample、Mode 1/3はleading edgeでshiftする。
/// `CLK_DIV`は4以上の偶数を指定する。SCLKのHigh/Lowはそれぞれ`CLK_DIV/2`クロックで、先頭と最終エッジも同じ幅になる。
/// `DATA_WIDTH`は1以上を指定する。
/// MISOはSCLKに同期して変化するソースシンクロナス入力として、指定したエッジで直接サンプルする。
/// 既定はCPHAに従い、CPHA=0はleading edge、CPHA=1はtrailing edgeでサンプルする。
/// スレーブがtrailing edgeでSDOを更新する場合は`MISO_SAMPLE_EDGE`に`Leading`を指定する。
pub module SpiMaster::<MODE: SpiMode = SpiMode::Mode0> #(
    param DATA_WIDTH      : u16           = 8                         , /// 通信ビット数 (8, 16, 24, 32など)
    param CLK_DIV         : u16           = 50                        , /// SCLK周期のシステムクロック数 (50MHz入力で50なら1MHz)
    param MISO_SAMPLE_EDGE: SpiSampleEdge = SpiSampleEdge::ModeDefault, /// MISOをサンプルするSCLKエッジ
) (
    clk: input clock, /// System Clock (50MHz)
    rst: input reset, /// Reset

    // 制御信号
    start  : input  logic            , /// 通信開始トリガー (1パルス)
    tx_data: input  logic<DATA_WIDTH>, /// 送信データ
    rx_data: output logic<DATA_WIDTH>, /// 受信データ
    busy   : output logic            , /// 通信中フラグ
    done   : output logic            , /// 完了フラグ (1パルス)

    // SPI物理ピン
    sclk: output logic, /// SPIクロック
    mosi: output logic, /// SPI MOSI
    miso: input  logic, /// SPI MISO
    cs_n: output logic, /// SPI Chip select (Active Low)
) {
    enum State {
        Idle, /// 待機
        Setup, /// CSを下げて最初のSCLKエッジまで待つ
        Transfer, /// SCLKを半周期ごとに切り替えて送受信する
        Finish, /// CSを上げて終了、最小アイドル時間確保
    }
    var state: State;

    const HALF         : u32 = CLK_DIV / 2;
    const DIV_CNT_WIDTH: u32 = $std::max::<u32>($clog2(HALF), 1);
    const BIT_CNT_WIDTH: u32 = $std::max::<u32>($clog2(DATA_WIDTH), 1);

    var div_cnt   : logic<DIV_CNT_WIDTH>; // 現在の半周期内の経過クロック
    var bit_cnt   : logic<BIT_CNT_WIDTH>; // 送信ビット数カウント
    var tx_shift  : logic<DATA_WIDTH>   ; // MOSI用シフトレジスタ
    var rx_shift  : logic<DATA_WIDTH>   ; // MISO用シフトレジスタ
    var sclk_reg  : logic               ; // SCLKの論理（レジスタで保持）
    var half_phase: logic               ; // 0: 次はleading、1: 次はtrailing

    var cpol             : logic;
    var cpha             : logic;
    var sample_on_leading: logic;

    always_comb {
        if MODE == SpiMode::Mode2 || MODE == SpiMode::Mode3 {
            cpol = 1;
        } else {
            cpol = 0;
        }

        if MODE == SpiMode::Mode1 || MODE == SpiMode::Mode3 {
            cpha = 1;
        } else {
            cpha = 0;
        }

        if MISO_SAMPLE_EDGE == SpiSampleEdge::Leading {
            sample_on_leading = 1;
        } else if MISO_SAMPLE_EDGE == SpiSampleEdge::Trailing {
            sample_on_leading = 0;
        } else {
            sample_on_leading = !cpha;
        }
    }

    always_ff {
        if_reset {
            state      = State::Idle;
            div_cnt    = 0;
            bit_cnt    = 0;
            tx_shift   = 0;
            rx_shift   = 0;
            half_phase = 0;
            busy       = 0;
            done       = 0;
            cs_n       = 1;
            if MODE == SpiMode::Mode2 || MODE == SpiMode::Mode3 {
                sclk_reg = 1;
            } else {
                sclk_reg = 0;
            }
        } else {
            done = 0;

            case state {
                State::Idle: {
                    busy     = 0;
                    cs_n     = 1;
                    sclk_reg = cpol;

                    if start & !busy {
                        tx_shift   = tx_data;
                        rx_shift   = 0;
                        bit_cnt    = 0;
                        div_cnt    = 0;
                        half_phase = 1; // Setupでleadingを出した後はtrailing
                        cs_n       = 0;
                        state      = State::Setup;
                        busy       = 1;
                    }
                }

                State::Setup: {
                    busy = 1;
                    cs_n = 0;

                    // CS setupとして半周期待ち、その最後に最初のleading edgeを出す。
                    if div_cnt >= HALF - 1 {
                        div_cnt  = 0;
                        sclk_reg = !cpol;
                        if sample_on_leading {
                            rx_shift = (rx_shift << 1) | miso;
                        }
                        state = State::Transfer;
                    } else {
                        div_cnt += 1'b1;
                    }
                }

                State::Transfer: {
                    busy = 1;
                    cs_n = 0;

                    if div_cnt >= HALF - 1 {
                        div_cnt = 0;
                        if half_phase == 1 {
                            // trailing edge
                            sclk_reg = cpol;
                            if cpha == 0 {
                                tx_shift = tx_shift << 1;
                            }
                            if !sample_on_leading {
                                rx_shift = (rx_shift << 1) | miso;
                            }
                            half_phase = 0;
                            if bit_cnt >= DATA_WIDTH - 1 {
                                state = State::Finish;
                            } else {
                                bit_cnt += 1'b1;
                            }
                        } else {
                            // leading edge
                            sclk_reg = !cpol;
                            if cpha == 1 && bit_cnt >: 0 {
                                tx_shift = tx_shift << 1;
                            }
                            if sample_on_leading {
                                rx_shift = (rx_shift << 1) | miso;
                            }
                            half_phase = 1;
                        }
                    } else {
                        div_cnt += 1'b1;
                    }
                }

                State::Finish: {
                    cs_n = 1;

                    // 次の通信までの最小アイドル時間 (t_CSHC)として半周期待つ。
                    if div_cnt >= HALF - 1 {
                        state = State::Idle;
                        done  = 1;
                        busy  = 0;
                    } else {
                        div_cnt += 1'b1;
                    }
                }
            }
        }
    }

    assign sclk    = sclk_reg;
    assign mosi    = tx_shift[msb];
    assign rx_data = rx_shift;
}

// ==========================================================================
// Verylネイティブテスト
// ==========================================================================

/// Mode 0で1byteを送受信し、受信値と完了通知を検証
#[test(test_spi_mode0_loopback)]
module test_spi_mode0_loopback {
    // SPI共通型をimport
    import Types::SpiMode;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var start   : logic   ;
    var tx_data : logic<8>;
    var rx_data : logic<8>;
    var busy    : logic   ;
    var done    : logic   ;
    var sclk_out: logic   ;
    var mosi    : logic   ;
    var miso    : logic   ; // ループバック用
    var cs_n    : logic   ;

    // MOSIをMISOにループバック接続
    assign miso = mosi;

    inst dut: SpiMaster::<SpiMode::Mode0> #(
        DATA_WIDTH: 8 ,
        CLK_DIV   : 20,
    ) (
        clk              ,
        rst              ,
        start            ,
        tx_data          ,
        rx_data          ,
        busy             ,
        done             ,
        sclk   : sclk_out,
        mosi             ,
        miso             ,
        cs_n             ,
    );

    initial {
        start   = 0;
        tx_data = 8'hA5;
        rst.assert();
        clk.next(10); // リセット解除後十分待機
        start = 1;
        clk.next(1);
        start = 0;
        clk.next(500); // 十分な時間待機
        $assert(busy == 0, "転送が完了していない");
        $assert(rx_data == 8'hA5, "ループバックデータ不一致");
        $finish();
    }
}

/// Mode 1で1byteを送受信し、受信値と完了通知を検証
#[test(test_spi_mode1_loopback)]
module test_spi_mode1_loopback {
    // SPI共通型をimport
    import Types::SpiMode;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var start   : logic   ;
    var tx_data : logic<8>;
    var rx_data : logic<8>;
    var busy    : logic   ;
    var done    : logic   ;
    var sclk_out: logic   ;
    var mosi    : logic   ;
    var miso    : logic   ; // ループバック用
    var cs_n    : logic   ;
    var rise_at : u32     ; // 先頭SCLK立ち上がりの観測サイクル
    var fall_at : u32     ; // 先頭SCLK立ち下がりの観測サイクル
    var seen    : logic   ; // 立ち上がり観測フラグ

    // MOSIをMISOにループバック接続
    assign miso = mosi;

    inst dut: SpiMaster::<SpiMode::Mode1> #(
        DATA_WIDTH: 8 ,
        CLK_DIV   : 20,
    ) (
        clk              ,
        rst              ,
        start            ,
        tx_data          ,
        rx_data          ,
        busy             ,
        done             ,
        sclk   : sclk_out,
        mosi             ,
        miso             ,
        cs_n             ,
    );

    initial {
        start   = 0;
        tx_data = 8'hA5;
        rst.assert();
        clk.next(10); // リセット解除後十分待機
        start = 1;
        clk.next(1);
        start = 0;
        // 先頭のSCLK High幅が半周期(CLK_DIV/2=10クロック)であることを確認
        rise_at = 0;
        fall_at = 0;
        seen    = 0;
        for i in 0..128 {
            if !seen && sclk_out == 1 {
                seen    = 1;
                rise_at = i;
            }
            if seen && sclk_out == 0 && fall_at == 0 {
                fall_at = i;
            }
            clk.next(1);
        }
        $assert(fall_at - rise_at == 10, "先頭SCLK High幅が半周期(10クロック)でない");
        clk.next(500); // 十分な時間待機
        $assert(busy == 0, "転送が完了していない");
        $assert(rx_data == 8'hA5, "ループバックデータ不一致");
        $finish();
    }
}

/// Mode 1のCS setupが半周期であることを検証
#[test(test_spi_mode1_cs_setup)]
module test_spi_mode1_cs_setup {
    import Types::SpiMode;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    var start   : logic   ;
    var tx_data : logic<8>;
    var rx_data : logic<8>;
    var busy    : logic   ;
    var done    : logic   ;
    var sclk_out: logic   ;
    var mosi    : logic   ;
    var miso    : logic   ;
    var cs_n    : logic   ;

    var cs_fall_at: u32  ;
    var rise_at   : u32  ;
    var cs_seen   : logic;
    var rise_seen : logic;

    inst dut: SpiMaster::<SpiMode::Mode1> #(
        DATA_WIDTH: 8 ,
        CLK_DIV   : 20,
    ) (
        clk              ,
        rst              ,
        start            ,
        tx_data          ,
        rx_data          ,
        busy             ,
        done             ,
        sclk   : sclk_out,
        mosi             ,
        miso             ,
        cs_n             ,
    );

    initial {
        start   = 0;
        tx_data = 8'h00;
        miso    = 1;
        rst.assert();
        clk.next(10);

        start = 1;
        clk.next(1);
        start = 0;

        cs_fall_at = 0;
        rise_at    = 0;
        cs_seen    = 0;
        rise_seen  = 0;
        for i in 0..64 {
            if !cs_seen && cs_n == 0 {
                cs_seen    = 1;
                cs_fall_at = i;
            }
            if cs_seen && !rise_seen && sclk_out == 1 {
                rise_seen = 1;
                rise_at   = i;
            }
            clk.next(1);
        }

        $assert(cs_seen && rise_seen, "CS setup observation failed");
        $assert(rise_at - cs_fall_at == 10, "Mode 1 CS setup must be a half period");
        $finish();
    }
}

/// Mode 1で外部スレーブモデルから既知のbyteを受信できることを検証
///
/// スレーブはCS立ち下がりで先頭bitを用意し、SCLK立ち上がりごとに次のbitを出力する。
/// MISOの2段synchronizerを経由してもbit順が崩れないことを確認する。
#[test(test_spi_mode1_external_slave)]
module test_spi_mode1_external_slave {
    import Types::SpiMode;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    const SLAVE_DATA: logic<8> = 8'hA5;

    var start   : logic   ;
    var tx_data : logic<8>;
    var rx_data : logic<8>;
    var busy    : logic   ;
    var done    : logic   ;
    var sclk_out: logic   ;
    var mosi    : logic   ;
    var miso    : logic   ;
    var cs_n    : logic   ;

    var slave_shift: logic<8>;
    var prev_sclk  : logic   ;
    var prev_cs    : logic   ;
    var done_seen  : logic   ;

    inst dut: SpiMaster::<SpiMode::Mode1> #(
        DATA_WIDTH: 8 ,
        CLK_DIV   : 20,
    ) (
        clk              ,
        rst              ,
        start            ,
        tx_data          ,
        rx_data          ,
        busy             ,
        done             ,
        sclk   : sclk_out,
        mosi             ,
        miso             ,
        cs_n             ,
    );

    always_ff (clk, rst) {
        if_reset {
            slave_shift = SLAVE_DATA;
            prev_sclk   = 0;
            prev_cs     = 1;
            miso        = 1;
            done_seen   = 0;
        } else {
            prev_sclk = sclk_out;
            prev_cs   = cs_n;

            if !cs_n && prev_cs {
                slave_shift = SLAVE_DATA;
                miso        = SLAVE_DATA[msb];
            } else if !cs_n && sclk_out && !prev_sclk {
                miso        = slave_shift[msb];
                slave_shift = {slave_shift[6:0], 1'b0};
            }

            if done {
                done_seen = 1;
            }
        }
    }

    initial {
        start   = 0;
        tx_data = 8'h00;
        rst.assert();
        clk.next(10);

        start = 1;
        clk.next(1);
        start = 0;
        clk.next(600);

        $assert(done_seen, "external slave transfer did not finish");
        $assert(!busy, "external slave transfer must clear busy");
        $assert(rx_data == SLAVE_DATA, "external slave data mismatch");
        $finish();
    }
}

/// Mode 3で外部スレーブモデルから既知のbyteを受信できることを検証
///
/// CPOL=1のため、スレーブはSCLK立ち下がりで次のbitを出力する。
#[test(test_spi_mode3_external_slave)]
module test_spi_mode3_external_slave {
    import Types::SpiMode;

    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen ( clk );

    const SLAVE_DATA: logic<8> = 8'h5A;

    var start   : logic   ;
    var tx_data : logic<8>;
    var rx_data : logic<8>;
    var busy    : logic   ;
    var done    : logic   ;
    var sclk_out: logic   ;
    var mosi    : logic   ;
    var miso    : logic   ;
    var cs_n    : logic   ;

    var slave_shift: logic<8>;
    var prev_sclk  : logic   ;
    var prev_cs    : logic   ;
    var done_seen  : logic   ;

    inst dut: SpiMaster::<SpiMode::Mode3> #(
        DATA_WIDTH: 8 ,
        CLK_DIV   : 20,
    ) (
        clk              ,
        rst              ,
        start            ,
        tx_data          ,
        rx_data          ,
        busy             ,
        done             ,
        sclk   : sclk_out,
        mosi             ,
        miso             ,
        cs_n             ,
    );

    always_ff (clk, rst) {
        if_reset {
            slave_shift = SLAVE_DATA;
            prev_sclk   = 1;
            prev_cs     = 1;
            miso        = SLAVE_DATA[msb];
            done_seen   = 0;
        } else {
            prev_sclk = sclk_out;
            prev_cs   = cs_n;

            if !cs_n && prev_cs {
                slave_shift = SLAVE_DATA;
                miso        = SLAVE_DATA[msb];
            } else if !cs_n && !sclk_out && prev_sclk {
                miso        = slave_shift[msb];
                slave_shift = {slave_shift[6:0], 1'b0};
            }

            if done {
                done_seen = 1;
            }
        }
    }

    initial {
        start   = 0;
        tx_data = 8'h00;
        rst.assert();
        clk.next(10);

        start = 1;
        clk.next(1);
        start = 0;
        clk.next(600);

        $assert(done_seen, "Mode 3 external slave transfer did not finish");
        $assert(!busy, "Mode 3 external slave transfer must clear busy");
        $assert(rx_data == SLAVE_DATA, "Mode 3 external slave data mismatch");
        $finish();
    }
}

/// Mode 2で1byteを送受信し、受信値と完了通知を検証
